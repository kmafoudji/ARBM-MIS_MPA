# Copier ce fichier en ".env" a la racine du projet, puis remplir les valeurs.
# Ne jamais committer le fichier ".env" reel (voir .gitignore).

# --- Django ---
DJANGO_SECRET_KEY=changeme-generer-une-cle-secrete-aleatoire
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL / PostGIS ---
POSTGRES_DB=arbm_mes
POSTGRES_USER=arbm_mes
POSTGRES_PASSWORD=arbm_mes

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- CORS (URL du frontend autorisee a appeler l'API) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Microsoft Entra ID (App Registration, tenant MillenniumPromise) ---
# A remplir une fois l'App Registration creee dans le portail Azure :
# Entra ID > App registrations > ARBM-MES-Dev
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8000/auth/callback

# --- Azure Blob Storage (utilise en production, optionnel en local) ---
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=arbm-mes-media
